{
  "manifest_version": 3,
  "name": "Instagram Feed Filter",
  "version": "1.0.0",
  "description": "Filter Instagram feed to show only content from allowed accounts",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.instagram.com/*"],
      "js": ["scripts/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Instagram Feed Filter"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
